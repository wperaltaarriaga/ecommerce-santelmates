# Variables de entorno de Firebase
# Copiá este archivo como `.env` (mismo nivel que package.json) y completá los valores.
# Se obtienen en: Firebase Console → Configuración del proyecto → Tus apps → App web → "Configuración del SDK".
# Vite solo expone al cliente las variables que empiezan con VITE_.
# Nunca subas el archivo `.env` al repositorio (ya está en .gitignore).

# Clave pública de la app web (no es secreta: la seguridad depende de las reglas de Firestore)
VITE_FIREBASE_API_KEY=

# Dominio de Firebase Authentication, ej: tu-proyecto.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# ID del proyecto de Firebase, ej: tu-proyecto
VITE_FIREBASE_PROJECT_ID=

# Bucket de Storage, ej: tu-proyecto.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=

# ID del remitente de Cloud Messaging (número)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ID de la app web, ej: 1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_APP_ID=
